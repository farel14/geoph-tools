from google.colab import drive
from google.oauth2.credentials import Credentials
from googleapiclient.discovery import build
from google.colab import auth
import gspread
from google.auth import default
from datetime import datetime

# CONFIGURATION PARAMETERS - EDIT THESE
# ============================================================================
SEARCH_KEYWORD = "report"  # The keyword to search for
PARENT_FOLDER_ID = None  # Set to None to search entire Drive, or paste folder ID from URL
SEARCH_IN_CONTENT = False  # True = search file content (slower), False = search filenames only
GOOGLE_SHEET_NAME = None  # Set custom name or None for auto-generated name with timestamp
SHARE_SHEET_PUBLICLY = True  # True = anyone with link can view, False = private
# ============================================================================

# Authenticate and mount Google Drive
auth.authenticate_user()
drive.mount('/content/drive')

# Build the Drive API service
drive_service = build('drive', 'v3')

# Authenticate for Google Sheets
creds, _ = default()
gc = gspread.authorize(creds)

def get_folder_path(folder_id):
    """Get the full path of a folder."""
    try:
        path_parts = []
        current_id = folder_id
        
        while current_id:
            folder = drive_service.files().get(
                fileId=current_id,
                fields='name, parents'
            ).execute()
            
            path_parts.insert(0, folder['name'])
            
            if 'parents' in folder:
                current_id = folder['parents'][0]
            else:
                break
        
        return '/' + '/'.join(path_parts)
    except:
        return 'Unknown Path'

def get_all_folders(parent_folder_id=None):
    """Recursively get all folder IDs under a parent folder."""
    folder_ids = []
    
    try:
        if parent_folder_id:
            query = f"'{parent_folder_id}' in parents and mimeType='application/vnd.google-apps.folder' and trashed=false"
        else:
            query = "mimeType='application/vnd.google-apps.folder' and trashed=false"
        
        page_token = None
        while True:
            results = drive_service.files().list(
                q=query,
                spaces='drive',
                fields='nextPageToken, files(id, name)',
                pageToken=page_token,
                pageSize=1000
            ).execute()
            
            folders = results.get('files', [])
            
            for folder in folders:
                folder_ids.append(folder['id'])
                # Recursively get subfolders
                subfolder_ids = get_all_folders(folder['id'])
                folder_ids.extend(subfolder_ids)
            
            page_token = results.get('nextPageToken')
            if not page_token:
                break
        
    except Exception as e:
        print(f'Error getting folders: {e}')
    
    return folder_ids

def search_files_recursive(keyword, parent_folder_id=None, search_in_content=False):
    """
    Recursively search for files in Google Drive by keyword.
    
    Args:
        keyword (str): The keyword to search for
        parent_folder_id (str): Starting folder ID (None for entire Drive)
        search_in_content (bool): If True, searches in file content too
    
    Returns:
        list: List of matching files with their details
    """
    all_files = []
    
    try:
        print("Getting all folders to search...")
        
        # Get all folder IDs to search
        if parent_folder_id:
            folder_ids = [parent_folder_id] + get_all_folders(parent_folder_id)
            print(f"Found {len(folder_ids)} folders to search (including subfolders)")
        else:
            folder_ids = [None]  # Search entire Drive
            print("Searching entire Google Drive...")
        
        # Search in each folder
        for i, folder_id in enumerate(folder_ids, 1):
            if folder_id:
                print(f"Searching folder {i}/{len(folder_ids)}...")
            
            # Build the query
            if search_in_content:
                query = f"fullText contains '{keyword}' and trashed=false"
            else:
                query = f"name contains '{keyword}' and trashed=false"
            
            if folder_id:
                query += f" and '{folder_id}' in parents"
            
            # Search for files
            page_token = None
            while True:
                results = drive_service.files().list(
                    q=query,
                    spaces='drive',
                    fields='nextPageToken, files(id, name, mimeType, modifiedTime, webViewLink, parents, size)',
                    pageToken=page_token,
                    pageSize=1000
                ).execute()
                
                files = results.get('files', [])
                
                # Add folder path to each file
                for file in files:
                    if 'parents' in file:
                        file['folderPath'] = get_folder_path(file['parents'][0])
                    else:
                        file['folderPath'] = '/My Drive'
                    
                    # Convert size to readable format
                    if 'size' in file:
                        size_bytes = int(file['size'])
                        if size_bytes < 1024:
                            file['sizeFormatted'] = f"{size_bytes} B"
                        elif size_bytes < 1024**2:
                            file['sizeFormatted'] = f"{size_bytes/1024:.2f} KB"
                        elif size_bytes < 1024**3:
                            file['sizeFormatted'] = f"{size_bytes/(1024**2):.2f} MB"
                        else:
                            file['sizeFormatted'] = f"{size_bytes/(1024**3):.2f} GB"
                    else:
                        file['sizeFormatted'] = 'N/A'
                
                all_files.extend(files)
                
                page_token = results.get('nextPageToken')
                if not page_token:
                    break
        
        print(f'\nFound {len(all_files)} file(s) matching "{keyword}"\n')
        
        return all_files
    
    except Exception as e:
        print(f'An error occurred: {e}')
        return []

def save_to_google_sheet(files, keyword, sheet_name=None):
    """Save search results to a Google Sheet."""
    try:
        if not sheet_name:
            timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
            sheet_name = f"Drive_Search_Results_{timestamp}"
        
        # Create a new Google Sheet
        spreadsheet = gc.create(sheet_name)
        worksheet = spreadsheet.sheet1
        
        # Set headers
        headers = ['File Name', 'Folder Path', 'File Type', 'Size', 'Modified Date', 'File ID', 'Link']
        worksheet.update('A1:G1', [headers])
        
        # Format headers
        worksheet.format('A1:G1', {
            'textFormat': {'bold': True},
            'backgroundColor': {'red': 0.2, 'green': 0.6, 'blue': 0.8}
        })
        
        # Prepare data rows
        rows = []
        for file in files:
            rows.append([
                file['name'],
                file.get('folderPath', 'N/A'),
                file['mimeType'],
                file.get('sizeFormatted', 'N/A'),
                file.get('modifiedTime', 'N/A'),
                file['id'],
                file.get('webViewLink', 'N/A')
            ])
        
        # Write data to sheet
        if rows:
            worksheet.update(f'A2:G{len(rows)+1}', rows)
        
        # Auto-resize columns
        worksheet.columns_auto_resize(0, 6)
        
        # Make the sheet public (optional)
        if SHARE_SHEET_PUBLICLY:
            spreadsheet.share('', perm_type='anyone', role='reader')
        
        print(f'\n✓ Results saved to Google Sheet: {sheet_name}')
        print(f'✓ Sheet URL: {spreadsheet.url}')
        
        return spreadsheet.url
    
    except Exception as e:
        print(f'Error saving to Google Sheet: {e}')
        return None

# Main execution
print("=" * 80)
print("GOOGLE DRIVE RECURSIVE FILE SEARCH")
print("=" * 80)
print(f"\nSearch Keyword: {SEARCH_KEYWORD}")
print(f"Parent Folder: {'Entire Drive' if PARENT_FOLDER_ID is None else PARENT_FOLDER_ID}")
print(f"Search in Content: {SEARCH_IN_CONTENT}")
print(f"Sheet Name: {GOOGLE_SHEET_NAME if GOOGLE_SHEET_NAME else 'Auto-generated'}")
print("\n" + "=" * 80)
print("STARTING SEARCH...")
print("=" * 80 + "\n")

# Perform search
found_files = search_files_recursive(SEARCH_KEYWORD, PARENT_FOLDER_ID, SEARCH_IN_CONTENT)

# Save to Google Sheet
if found_files:
    print("\n" + "=" * 80)
    save_to_google_sheet(found_files, SEARCH_KEYWORD, GOOGLE_SHEET_NAME)
    print("=" * 80)
else:
    print("\nNo files found to save.")